{
  "expo": {
    "name": "LifeOS",
    "slug": "lifeos",
    "scheme": "lifeos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": ["**/*"],
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "enableFTS": true,
          "useSQLCipher": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#66E3FF",
          "defaultChannel": "lifeos-reminders"
        }
      ],
      [
        "expo-camera",
        {
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ]
    ],
    "android": {
      "package": "com.lifeos.personalassistant",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#070A0F"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "RECORD_AUDIO",
        "READ_CONTACTS",
        "CALL_PHONE",
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "FOREGROUND_SERVICE",
        "WAKE_LOCK"
      ],
      "blockedPermissions": [
        "ACCESS_NETWORK_STATE",
        "INTERNET"
      ]
    },
    "newArchEnabled": true,
    "extra": {
      "offlineOnly": true
    }
  }
}
